"""Circle — geometry > 2D Geometry. Area, circumference, diameter, radius. Solve from any one."""
from core.registry import register
import math

@register(
    slug="circle-area",
    name="Circle Area Calculator",
    section="maths",
    sub="Geometry",
    tags=["circle", "area", "circumference", "radius", "diameter", "geometry"],
    formula="area = \u03c0r\u00b2 ; circumference = 2\u03c0r ; diameter = 2r",
    summary="Find a circle's area, circumference, diameter and radius. Enter any one of these and the rest are worked out.",
    viz_template="viz/circle-area.html",
)
def compute(known: str = "radius", value: float = 5):
    k = str(known or "radius").strip().lower()
    try:
        v = float(value)
    except (TypeError, ValueError):
        return {"error": "Enter a number."}
    if v <= 0:
        return {"error": "Value must be greater than zero."}
    if k == "radius":
        r = v
    elif k == "diameter":
        r = v / 2
    elif k == "area":
        r = math.sqrt(v / math.pi)
    elif k == "circumference":
        r = v / (2 * math.pi)
    else:
        return {"error": "Choose radius, diameter, area or circumference."}
    area = math.pi * r * r
    circ = 2 * math.pi * r
    diam = 2 * r
    steps = [
        {"label": "Radius", "math": r"\(r = " + ("%.4g" % r) + r"\)", "note": "Found from your " + k + "."},
        {"label": "Area", "math": r"\(A = \pi r^2 = " + ("%.4g" % area) + r"\)", "note": "Pi times radius squared."},
        {"label": "Circumference", "math": r"\(C = 2\pi r = " + ("%.4g" % circ) + r"\)", "note": "Distance around the circle."},
    ]
    return {
        "result": "Radius " + ("%.4g" % r) + ", area " + ("%.4g" % area) + ", circumference " + ("%.4g" % circ) + ", diameter " + ("%.4g" % diam),
        "radius": round(r, 6), "area": round(area, 6), "circumference": round(circ, 6), "diameter": round(diam, 6),
        "steps": steps,
    }

from core.faqs import load_sibling_faq
load_sibling_faq(__file__)

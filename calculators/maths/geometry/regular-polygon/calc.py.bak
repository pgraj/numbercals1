"""Regular polygon — geometry > 2D Geometry. Area, perimeter and interior angle from n sides and side length."""
from core.registry import register
import math

@register(
    slug="regular-polygon",
    name="Regular Polygon Calculator",
    section="maths",
    sub="Geometry",
    tags=["polygon", "regular", "area", "perimeter", "interior angle", "geometry"],
    formula="area = \u00bc\u00b7n\u00b7s\u00b2\u00b7cot(\u03c0/n) ; interior angle = (n\u22122)\u00d7180/n",
    summary="Find the area, perimeter and interior angle of a regular polygon (all sides and angles equal) from the number of sides and the side length.",
    viz_template="viz/regular-polygon.html",
)
def compute(sides: float = 6, side_length: float = 5):
    try:
        n = int(float(sides)); s = float(side_length)
    except (TypeError, ValueError):
        return {"error": "Enter whole number of sides and a side length."}
    if n < 3:
        return {"error": "A polygon needs at least 3 sides."}
    if s <= 0:
        return {"error": "Side length must be greater than zero."}
    perim = n * s
    area = 0.25 * n * s * s / math.tan(math.pi / n)
    interior = (n - 2) * 180.0 / n
    steps = [
        {"label": "Perimeter", "math": r"\(P = n s = " + str(n) + r" \times " + ("%g" % s) + r" = " + ("%g" % perim) + r"\)", "note": "All " + str(n) + " sides are equal."},
        {"label": "Interior angle", "math": r"\(\dfrac{(n-2)\times 180}{n} = " + ("%.4g" % interior) + r"^\circ\)", "note": "Each corner's angle."},
        {"label": "Area", "math": r"\(A = \tfrac{1}{4} n s^2 \cot\!\left(\tfrac{\pi}{n}\right) = " + ("%.4g" % area) + r"\)", "note": "Built from n triangles meeting at the centre."},
    ]
    return {
        "result": "Area " + ("%.4g" % area) + ", perimeter " + ("%g" % perim) + ", interior angle " + ("%.4g" % interior) + "\u00b0",
        "area": round(area, 6), "side_length": s, "perimeter": round(perim, 6), "interior_angle": round(interior, 4),
        "sides": n, "steps": steps,
    }

from core.faqs import load_sibling_faq
load_sibling_faq(__file__)

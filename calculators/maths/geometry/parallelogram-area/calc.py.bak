"""Parallelogram — geometry > 2D Geometry. Area from base x height, perimeter from sides."""
from core.registry import register

@register(
    slug="parallelogram-area",
    name="Parallelogram Area Calculator",
    section="maths",
    sub="Geometry",
    tags=["parallelogram", "area", "perimeter", "geometry"],
    formula="area = base\u00d7height ; perimeter = 2(base+side)",
    summary="Find the area and perimeter of a parallelogram from its base, perpendicular height and slanted side.",
    viz_template="viz/parallelogram-area.html",
)
def compute(base: float = 8, height: float = 5, side: float = 6):
    try:
        b = float(base); h = float(height); s = float(side)
    except (TypeError, ValueError):
        return {"error": "Enter numbers only."}
    if b <= 0 or h <= 0 or s <= 0:
        return {"error": "Base, height and side must be greater than zero."}
    area = b * h
    perim = 2 * (b + s)
    steps = [
        {"label": "Area", "math": r"\(A = b \times h = " + ("%g" % b) + r" \times " + ("%g" % h) + r" = " + ("%g" % area) + r"\)", "note": "Height is the perpendicular distance, not the slanted side."},
        {"label": "Perimeter", "math": r"\(P = 2(b + s) = 2(" + ("%g" % b) + r" + " + ("%g" % s) + r") = " + ("%g" % perim) + r"\)", "note": "Two bases plus two slanted sides."},
    ]
    return {
        "result": "Area " + ("%g" % area) + ", perimeter " + ("%g" % perim),
        "area": round(area, 6), "base": b, "height": h, "perimeter": round(perim, 6), "steps": steps,
    }

from core.faqs import load_sibling_faq
load_sibling_faq(__file__)

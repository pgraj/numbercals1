"""Square pyramid — geometry > 3D Geometry. Volume, surface area and slant height."""
from core.registry import register
import math

@register(
    slug="square-pyramid-volume",
    name="Square Pyramid Volume Calculator",
    section="maths",
    sub="Geometry",
    tags=["pyramid", "square pyramid", "volume", "surface area", "slant height", "geometry"],
    formula="volume = \u2153a\u00b2h ; slant = \u221a(h\u00b2+(a/2)\u00b2) ; surface = a\u00b2 + 2a\u00b7slant",
    summary="Find a square-based pyramid's volume, total surface area and slant height from its base edge and vertical height.",
    viz_template="viz/square-pyramid-volume.html",
)
def compute(base_edge: float = 6, height: float = 8):
    try:
        a = float(base_edge); h = float(height)
    except (TypeError, ValueError):
        return {"error": "Enter numbers for base edge and height."}
    if a <= 0 or h <= 0:
        return {"error": "Base edge and height must be greater than zero."}
    vol = a * a * h / 3.0
    slant = math.sqrt(h * h + (a / 2) ** 2)
    sa = a * a + 2 * a * slant
    steps = [
        {"label": "Slant height", "math": r"\(l = \sqrt{h^2 + (a/2)^2} = " + ("%.4g" % slant) + r"\)", "note": "From the base-edge midpoint up to the apex."},
        {"label": "Volume", "math": r"\(V = \tfrac{1}{3} a^2 h = \tfrac{1}{3} \times " + ("%g" % a) + r"^2 \times " + ("%g" % h) + r" = " + ("%.4g" % vol) + r"\)", "note": "One third of base area times height."},
        {"label": "Surface area", "math": r"\(A = a^2 + 2 a l = " + ("%.4g" % sa) + r"\)", "note": "Square base plus four triangular faces."},
    ]
    return {
        "result": "Volume " + ("%.4g" % vol) + ", surface area " + ("%.4g" % sa) + ", slant height " + ("%.4g" % slant),
        "volume": round(vol, 6), "base_edge": a, "height": h, "surface_area": round(sa, 6), "slant_height": round(slant, 6), "steps": steps,
    }

from core.faqs import load_sibling_faq
load_sibling_faq(__file__)

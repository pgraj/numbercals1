"""Cone — geometry > 3D Geometry. Volume, surface area and slant height of a right circular cone."""
from core.registry import register
import math

@register(
    slug="cone-volume",
    name="Cone Volume Calculator",
    section="maths",
    sub="Geometry",
    tags=["cone", "volume", "surface area", "slant height", "geometry"],
    formula="volume = \u2153\u03c0r\u00b2h ; slant = \u221a(r\u00b2+h\u00b2) ; surface = \u03c0r(r+slant)",
    summary="Find a right circular cone's volume, total surface area and slant height from its base radius and vertical height.",
    viz_template="viz/cone-volume.html",
)
def compute(radius: float = 3, height: float = 4):
    try:
        r = float(radius); h = float(height)
    except (TypeError, ValueError):
        return {"error": "Enter numbers for radius and height."}
    if r <= 0 or h <= 0:
        return {"error": "Radius and height must be greater than zero."}
    vol = math.pi * r * r * h / 3.0
    slant = math.sqrt(r * r + h * h)
    sa = math.pi * r * (r + slant)
    steps = [
        {"label": "Slant height", "math": r"\(l = \sqrt{r^2 + h^2} = \sqrt{" + ("%g^2 + %g^2" % (r, h)) + r"} = " + ("%.4g" % slant) + r"\)", "note": "From the base edge to the tip, via Pythagoras."},
        {"label": "Volume", "math": r"\(V = \tfrac{1}{3}\pi r^2 h = " + ("%.4g" % vol) + r"\)", "note": "Exactly one third of the matching cylinder."},
        {"label": "Surface area", "math": r"\(A = \pi r(r + l) = " + ("%.4g" % sa) + r"\)", "note": "Base circle plus the curved cone surface."},
    ]
    return {
        "result": "Volume " + ("%.4g" % vol) + ", surface area " + ("%.4g" % sa) + ", slant height " + ("%.4g" % slant),
        "volume": round(vol, 6), "radius": r, "height": h, "surface_area": round(sa, 6), "slant_height": round(slant, 6), "steps": steps,
    }

from core.faqs import load_sibling_faq
load_sibling_faq(__file__)

"""Cube — geometry > 3D Geometry. Volume, surface area and space diagonal from the edge."""
from core.registry import register
import math

@register(
    slug="cube-volume",
    name="Cube Volume Calculator",
    section="maths",
    sub="Geometry",
    tags=["cube", "volume", "surface area", "diagonal", "geometry"],
    formula="volume = s\u00b3 ; surface area = 6s\u00b2 ; space diagonal = s\u221a3",
    summary="Find the volume, surface area and space diagonal of a cube from its edge length.",
    viz_template="viz/cube-volume.html",
)
def compute(edge: float = 4):
    try:
        s = float(edge)
    except (TypeError, ValueError):
        return {"error": "Enter a number for the edge length."}
    if s <= 0:
        return {"error": "Edge length must be greater than zero."}
    vol = s ** 3
    sa = 6 * s * s
    diag = s * math.sqrt(3)
    steps = [
        {"label": "Volume", "math": r"\(V = s^3 = " + ("%g" % s) + r"^3 = " + ("%g" % vol) + r"\)", "note": "Edge cubed."},
        {"label": "Surface area", "math": r"\(A = 6s^2 = 6 \times " + ("%g" % s) + r"^2 = " + ("%g" % sa) + r"\)", "note": "Six identical square faces."},
        {"label": "Space diagonal", "math": r"\(d = s\sqrt{3} = " + ("%.4g" % diag) + r"\)", "note": "Corner to opposite corner through the cube."},
    ]
    return {
        "result": "Volume " + ("%g" % vol) + ", surface area " + ("%g" % sa) + ", space diagonal " + ("%.4g" % diag),
        "volume": round(vol, 6), "edge": s, "surface_area": round(sa, 6), "space_diagonal": round(diag, 6), "steps": steps,
    }

from core.faqs import load_sibling_faq
load_sibling_faq(__file__)

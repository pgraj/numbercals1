"""Triangle — geometry > 2D Geometry. Area from base x height, or from three sides via Heron."""
from core.registry import register
import math

@register(
    slug="triangle-area",
    name="Triangle Area Calculator",
    section="maths",
    sub="Geometry",
    tags=["triangle", "area", "heron", "base", "height", "geometry"],
    formula="\u00bd\u00d7base\u00d7height, or Heron: \u221a(s(s\u2212a)(s\u2212b)(s\u2212c)) with s = (a+b+c)/2",
    summary="Find a triangle's area from base and height, or from its three side lengths using Heron's formula. Choose the method to match what you know.",
    viz_template="viz/triangle-area.html",
)
def compute(method: str = "base_height", base: float = 6, height: float = 4,
            a: float = 3, b: float = 4, c: float = 5):
    m = str(method or "base_height").strip().lower()
    if m in ("heron", "sides", "three_sides", "abc"):
        try:
            A = float(a); B = float(b); C = float(c)
        except (TypeError, ValueError):
            return {"error": "Enter numbers for the three sides."}
        if A <= 0 or B <= 0 or C <= 0:
            return {"error": "Side lengths must be greater than zero."}
        if A + B <= C or A + C <= B or B + C <= A:
            return {"error": "Those sides cannot form a triangle (triangle inequality)."}
        s = (A + B + C) / 2
        area = math.sqrt(s * (s - A) * (s - B) * (s - C))
        perim = A + B + C
        steps = [
            {"label": "Semi-perimeter", "math": r"\(s = \dfrac{a+b+c}{2} = \dfrac{" + ("%g+%g+%g" % (A, B, C)) + r"}{2} = " + ("%g" % s) + r"\)", "note": "Half the perimeter."},
            {"label": "Heron's formula", "math": r"\(A = \sqrt{s(s-a)(s-b)(s-c)}\)", "note": "Works from sides alone, no height needed."},
            {"label": "Area", "math": r"\(A = " + ("%.4g" % area) + r"\)", "note": "The triangle's area."},
        ]
        return {
            "result": "Area " + ("%.4g" % area) + " (Heron), perimeter " + ("%g" % perim),
            "area": round(area, 6), "perimeter": round(perim, 6), "semi_perimeter": round(s, 6),
            "method": "heron", "steps": steps,
        }
    # base x height
    try:
        bs = float(base); h = float(height)
    except (TypeError, ValueError):
        return {"error": "Enter numbers for base and height."}
    if bs <= 0 or h <= 0:
        return {"error": "Base and height must be greater than zero."}
    area = 0.5 * bs * h
    steps = [
        {"label": "Formula", "math": r"\(A = \tfrac{1}{2} \times b \times h\)", "note": "Half of base times height."},
        {"label": "Substitute", "math": r"\(A = \tfrac{1}{2} \times " + ("%g" % bs) + r" \times " + ("%g" % h) + r" = " + ("%g" % area) + r"\)", "note": "Your numbers."},
    ]
    return {
        "result": "Area " + ("%g" % area) + " (from base \u00d7 height)",
        "area": round(area, 6), "method": "base_height", "steps": steps,
    }

from core.faqs import load_sibling_faq
load_sibling_faq(__file__)
